# Dev stack only (docker-compose.dev.yml): local postgres instead of Supabase
LOG_LEVEL=DEBUG
ENVIRONMENT=development
SECRET_KEY=YOUR-DEV-SECRET-KEY

# db credentials (local postgres container, see docker/grocery-management-postgres.yml)
DB_USER=grocery_dev
DB_PASSWORD=grocery_dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=grocery-dev

# db pool
POOL_SIZE=1
MAX_OVERFLOW=0
POOL_TIMEOUT=30.0
POOL_RECYCLE=1800


# redis config
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=300
ALLOW_ORIGINS=["http://localhost:3000"]

# gemini config
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
GEMINI_PROVIDER=real # real | fake

# fake gemini (GEMINI_PROVIDER=fake)
FAKE_GEMINI_LATENCY_S=2
FAKE_GEMINI_RPM=0 # 0 = no limit
FAKE_GEMINI_FAIL_RATE=0


#rabbitmq config
RABBIT_MQ_CONNECTION_URL=amqp://user:password@rabbitmq:5672//

